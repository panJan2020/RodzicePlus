# Skopiuj do .env (plik .env NIE trafia do gita)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
# Adresy frontendu, które mogą wołać API (CORS). Lokalnie Flutter web startuje na losowym porcie,
# dlatego w trybie dev dopuszczamy localhost na dowolnym porcie (patrz config.py).
CORS_ORIGINS=http://localhost:8080,https://twoja-aplikacja.web.app
ADMIN_TOKEN=zmien-mnie
